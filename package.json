{
  "name": "dottree",
  "displayName": "dottree",
  "description": "Maintain Tree files with automatic prefixes, syntax highlighting, and Enter/Tab helpers.",
  "version": "0.0.7",
  "publisher": "idlesilver",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/idlesilver/dottree.git"
  },
  "homepage": "https://github.com/idlesilver/dottree",
  "bugs": {
    "url": "https://github.com/idlesilver/dottree/issues"
  },
  "files": [
    "dist",
    "syntaxes",
    "images",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:tree",
    "onCommand:dottree.indent",
    "onCommand:dottree.outdent",
    "onCommand:dottree.newline"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "dottree.indent", "title": "Dot Tree: Indent (maintain prefixes)" },
      { "command": "dottree.outdent", "title": "Dot Tree: Outdent (maintain prefixes)" },
      { "command": "dottree.newline", "title": "Dot Tree: New Line (same level)" }
    ],
    "languages": [
      {
        "id": "tree",
        "aliases": ["Tree", "tree"],
        "extensions": [".tree"]
      }
    ],
    "grammars": [
      {
        "language": "tree",
        "scopeName": "source.tree",
        "path": "./syntaxes/tree.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "dottreeFolder",
        "superType": "namespace",
        "description": "A folder item in a tree file."
      },
      {
        "id": "dottreeFile",
        "superType": "string",
        "description": "A file item in a tree file."
      },
      {
        "id": "dottreeComment",
        "superType": "comment",
        "description": "A comment in a tree file."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tree",
        "scopes": {
          "dottreeFolder": ["entity.name.namespace.tree"],
          "dottreeFile": ["string.unquoted.filename.tree"],
          "dottreeComment": ["comment.line.number-sign.tree"]
        }
      }
    ],
    "keybindings": [
      {
        "command": "dottree.indent",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && dottree.activeTreeLine && !suggestWidgetVisible && !inlineSuggestionVisible"
      },
      {
        "command": "dottree.outdent",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && dottree.activeTreeLine"
      },
      {
        "command": "dottree.newline",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && dottree.activeTreeLine"
      }
    ],
    "configuration": {
      "title": "dottree",
      "properties": {
        "dottree.style": {
          "type": "string",
          "enum": ["unicode", "ascii"],
          "default": "unicode",
          "description": "Tree prefix style to emit after normalization."
        },
        "dottree.indentSubtreeOnSingleCursor": {
          "type": "boolean",
          "default": true,
          "description": "When there's no selection, indent/outdent the current line plus its subtree."
        }
      }
    },
    "configurationDefaults": {
      "[tree]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package:vsix": "npm run build && vsce package --no-dependencies",
    "package:vsix:latest": "npm run build && vsce package --no-dependencies --out dottree-latest.vsix",
    "publish": "npm run build && vsce publish --no-dependencies && npx ovsx publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
