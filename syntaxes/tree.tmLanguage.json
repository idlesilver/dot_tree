{
  "name": "Tree",
  "scopeName": "source.tree",
  "patterns": [
    {
      "match": "^(\\s*#.*)$",
      "captures": {
        "1": {
          "name": "comment.line.number-sign.tree"
        }
      }
    },
    {
      "match": "^((?:(?:[│|][ \\t]*|[ \\t]+)*(?:[├└][─-]+|\\|-|\\\\-|\\+--|`--)[ \\t]*)?)([^#\\n]*?/)(?:[ \\t]+(#.*)|[ \\t]*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.tree"
        },
        "2": {
          "name": "entity.name.namespace.tree"
        },
        "3": {
          "name": "comment.line.number-sign.tree"
        }
      }
    },
    {
      "match": "^((?:(?:[│|][ \\t]*|[ \\t]+)*(?:[├└][─-]+|\\|-|\\\\-|\\+--|`--)[ \\t]*)?)([^#\\n][^#\\n]*?)(\\s+#.*)?$",
      "captures": {
        "1": {
          "name": "punctuation.definition.tree"
        },
        "2": {
          "name": "string.unquoted.filename.tree"
        },
        "3": {
          "name": "comment.line.number-sign.tree"
        }
      }
    }
  ]
}
